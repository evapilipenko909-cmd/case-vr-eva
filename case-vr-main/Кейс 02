import bpy

# Кейс 2. Создание и назначение синего PBR-материала.
obj = bpy.data.objects.get("VR_Cube")
if obj is None:
    bpy.ops.mesh.primitive_cube_add(size=1, location=(0, 0, 1))
    obj = bpy.context.active_object
    obj.name = "VR_Cube"
mat = bpy.data.materials.get("VR_Material") or bpy.data.materials.new("VR_Material")
mat.use_nodes = True
bsdf = mat.node_tree.nodes.get("Principled BSDF")
bsdf.inputs["Base Color"].default_value = (0.04, 0.22, 0.8, 1.0)
bsdf.inputs["Roughness"].default_value = 0.3
obj.data.materials.clear()
obj.data.materials.append(mat)
print("Материал назначен:", mat.name)
print("Материалов на объекте:", len(obj.data.materials))
